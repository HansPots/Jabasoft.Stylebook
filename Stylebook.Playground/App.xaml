<Application x:Class="Stylebook.Playground.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Stylebook.Playground"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Shared typography/styles every real app merges in too
                     - see Stylebook.Components/Styles/Theme.xaml. -->
                <ResourceDictionary Source="pack://application:,,,/Stylebook.Components;component/Styles/Theme.xaml" />
                <!-- The Stylebook tool's own chrome (menu strip, dropdown,
                     ...) has one fixed look and stays out of theme
                     switching entirely - Visual Studio dark, always.
                     Anything that SHOULD switch (a preview surface) merges
                     its own Themes/*.xaml closer to itself instead, see
                     MainWindow.xaml's StylePreviewArea. -->
                <ResourceDictionary Source="pack://application:,,,/Stylebook.Components;component/Styles/Themes/VisualStudio.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
