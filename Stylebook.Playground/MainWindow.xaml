<Window x:Class="Stylebook.Playground.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:Stylebook.Components.Controls;assembly=Stylebook.Components"
        mc:Ignorable="d"
        Title="Stylebook"
        Height="1140" Width="2560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}">

    <Window.Resources>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
        </Style>
        <Style TargetType="Button" x:Key="AddComponentButtonStyle">
            <!-- Foreground is AccentForegroundBrush, niet TextPrimaryBrush:
                 in LCARS zijn AccentColor en TextPrimaryColor toevallig
                 gelijk, wat oranje-op-oranje tekst zou geven. -->
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="4,0,0,0" />
        </Style>
        <!-- Verwijder-/herstel-knop: bewust ingetogen (Surface i.p.v. Accent). -->
        <Style TargetType="Button" x:Key="DeleteComponentButtonStyle" BasedOn="{StaticResource AddComponentButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        </Style>
        <!-- Naam-invoerveld - gebruikt bij het opslaan van een Pagina-concept. -->
        <Style TargetType="TextBox" x:Key="NameEntryStyle">
            <Setter Property="Background" Value="{DynamicResource BackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
            <Setter Property="Padding" Value="4" />
        </Style>
        <Style TargetType="TextBox" x:Key="EditorFieldStyle">
            <Setter Property="Background" Value="{DynamicResource BackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="AcceptsReturn" Value="True" />
        </Style>
        <Style TargetType="Button" x:Key="EditorActionButtonStyle" BasedOn="{StaticResource AddComponentButtonStyle}">
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Height" Value="32" />
        </Style>
        <!-- Stylebook/Bibliotheek-tabs: RadioButtons die zich als tabblad
             gedragen (GroupName houdt ze onderling exclusief). -->
        <Style TargetType="RadioButton" x:Key="BuilderModeTabStyle">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
            <Setter Property="Padding" Value="{StaticResource SpaceSmall}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!--
        Vaste indeling van het style-venster: links een 256px strook voor
        het menu (thema-kiezer + modus-schakelaar), rechts het style-
        oppervlak zelf waar de daadwerkelijke styling te zien is.
    -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="256" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Menu-strook -->
        <Border Grid.Column="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="{StaticResource SpaceMedium}">
                    <TextBox Text="MENU"
                             Style="{StaticResource SelectableTextStyle}"
                             Foreground="{DynamicResource TextMutedBrush}"
                             FontFamily="{StaticResource AppFontFamily}"
                             FontSize="{StaticResource FontSizeSmall}"
                             Margin="0,0,0,16" />

                    <!-- Stijl-wisselaar, bovenaan zodat 'ie voor de hele
                         app geldt (chrome en preview delen dezelfde
                         resources, zie App.xaml.cs). Wisselen zelf is
                         niet-destructief - elk thema bewaart zijn eigen
                         tokens (zie App.SwitchTheme). "Herstel naar
                         standaard" is de enige plek die een thema WEL
                         terugzet naar zijn vaste preset-waarden
                         (ResetThemeToPreset_Click/DbThemeBuilder.ApplyPreset),
                         en dat gebeurt alleen na expliciete bevestiging. -->
                    <ComboBox x:Name="ThemePresetPicker"
                              SelectionChanged="ThemePreset_SelectionChanged"
                              Margin="0,0,0,4" />
                    <Button Content="Herstel naar standaard"
                            Click="ResetThemeToPreset_Click"
                            Style="{StaticResource DeleteComponentButtonStyle}"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,16"
                            AutomationProperties.Name="Herstel naar standaard" />

                    <!-- Stylebook: het palet met de hand aanpassen - zie
                         StylebookMode_Checked/BuildStylebookPanel.
                         Bibliotheek: de echte, gecompileerde componenten
                         uit Stylebook.Components bekijken/samenstellen -
                         zie LibraryMode_Checked. -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <RadioButton x:Name="StylebookModeButton"
                                     Grid.Column="0"
                                     GroupName="BuilderMode"
                                     Style="{StaticResource BuilderModeTabStyle}"
                                     Checked="StylebookMode_Checked"
                                     AutomationProperties.Name="Stylebook">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{StaticResource IconPalette}" FontFamily="{StaticResource IconFontFamily}" FontSize="16" HorizontalAlignment="Center" />
                                <TextBlock Text="Stylebook" FontSize="10" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="LibraryModeButton"
                                     Grid.Column="1"
                                     GroupName="BuilderMode"
                                     Style="{StaticResource BuilderModeTabStyle}"
                                     Checked="LibraryMode_Checked"
                                     AutomationProperties.Name="Bibliotheek">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{StaticResource IconDashboard}" FontFamily="{StaticResource IconFontFamily}" FontSize="16" HorizontalAlignment="Center" />
                                <TextBlock Text="Bibliotheek" FontSize="10" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Style-oppervlak: hier komt de daadwerkelijke styling/preview te
             staan. Twee lagen, maar maar 1 zichtbaar (zie SetBuilderMode
             in code-behind): StylebookContent toont het hand-bewerkbare
             palet; LibraryCanvasArea toont de echte, gecompileerde
             componenten uit Stylebook.Components. -->
        <Grid x:Name="StylePreviewArea" Grid.Column="1">
            <ContentControl x:Name="StylebookContent" Visibility="Collapsed" />

            <!-- Bibliotheek: puur bekijken, geen database - toont de
                 ECHTE, gecompileerde UserControls uit Stylebook.Components
                 (Regions/<Regio>/*), gevonden via reflectie (zie
                 DiscoverLibraryControls in code-behind). Twee standen:
                 Onderdeel (1 component isoleren) en Pagina (per regio een
                 component kiezen, samen in een echte Basis). -->
            <Border x:Name="LibraryCanvasArea" Background="{DynamicResource BackgroundBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="{StaticResource SpaceMedium}">
                        <RadioButton x:Name="LibraryComponentSubModeButton"
                                     GroupName="LibrarySubMode"
                                     Content="Onderdeel"
                                     Checked="LibraryComponentSubMode_Checked"
                                     Margin="0,0,16,0" />
                        <RadioButton x:Name="LibraryPageSubModeButton"
                                     GroupName="LibrarySubMode"
                                     Content="Pagina"
                                     Checked="LibraryPageSubMode_Checked" />
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <!-- Onderdeel: 1 component isoleren. -->
                        <Grid x:Name="LibraryComponentPanel">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="0,0,1,0">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ListBox x:Name="LibraryComponents"
                                             Margin="{StaticResource SpaceMedium}"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             SelectionChanged="LibraryComponents_SelectionChanged" />
                                </ScrollViewer>
                            </Border>

                            <Grid Grid.Column="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border x:Name="LibraryTestContainerBorder"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            ClipToBounds="True">
                                        <ContentControl x:Name="LibraryPreviewContent" />
                                    </Border>
                                </Border>

                                <TextBox x:Name="LibraryContainerSizeLabel"
                                         Grid.Row="1"
                                         Text="Containerformaat: -"
                                         Style="{StaticResource SelectableTextStyle}"
                                         Foreground="{DynamicResource TextMutedBrush}"
                                         FontFamily="{StaticResource AppFontFamily}"
                                         FontSize="{StaticResource FontSizeSmall}"
                                         HorizontalAlignment="Center"
                                         Margin="0,8,0,16" />
                            </Grid>
                        </Grid>

                        <!-- Pagina: per regio een echte component kiezen (of
                             "(leeg)"), samen getoond in een echte Basis op
                             het echte 1920x1080-formaat - zo beoordeel je
                             een complete pagina los van welke applicatie
                             'm straks echt gebruikt. -->
                        <Grid x:Name="LibraryPagePanel" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="0,0,1,0">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="{StaticResource SpaceMedium}">
                                        <TextBox Text="HEADER" Style="{StaticResource SelectableTextStyle}" Foreground="{DynamicResource TextMutedBrush}" FontFamily="{StaticResource AppFontFamily}" FontSize="{StaticResource FontSizeSmall}" Margin="0,0,0,4" />
                                        <ComboBox x:Name="LibraryPageHeaderPicker" Tag="Header" SelectionChanged="LibraryPagePicker_SelectionChanged" Margin="0,0,0,16" />

                                        <TextBox Text="MENU" Style="{StaticResource SelectableTextStyle}" Foreground="{DynamicResource TextMutedBrush}" FontFamily="{StaticResource AppFontFamily}" FontSize="{StaticResource FontSizeSmall}" Margin="0,0,0,4" />
                                        <ComboBox x:Name="LibraryPageMenuPicker" Tag="Menu" SelectionChanged="LibraryPagePicker_SelectionChanged" Margin="0,0,0,16" />

                                        <TextBox Text="INHOUD" Style="{StaticResource SelectableTextStyle}" Foreground="{DynamicResource TextMutedBrush}" FontFamily="{StaticResource AppFontFamily}" FontSize="{StaticResource FontSizeSmall}" Margin="0,0,0,4" />
                                        <ComboBox x:Name="LibraryPageInhoudPicker" Tag="Inhoud" SelectionChanged="LibraryPagePicker_SelectionChanged" Margin="0,0,0,16" />

                                        <TextBox Text="ACTIE" Style="{StaticResource SelectableTextStyle}" Foreground="{DynamicResource TextMutedBrush}" FontFamily="{StaticResource AppFontFamily}" FontSize="{StaticResource FontSizeSmall}" Margin="0,0,0,4" />
                                        <ComboBox x:Name="LibraryPageActiePicker" Tag="Actie" SelectionChanged="LibraryPagePicker_SelectionChanged" Margin="0,0,0,16" />

                                        <TextBox Text="FOOTER" Style="{StaticResource SelectableTextStyle}" Foreground="{DynamicResource TextMutedBrush}" FontFamily="{StaticResource AppFontFamily}" FontSize="{StaticResource FontSizeSmall}" Margin="0,0,0,4" />
                                        <ComboBox x:Name="LibraryPageFooterPicker" Tag="Footer" SelectionChanged="LibraryPagePicker_SelectionChanged" Margin="0,0,0,16" />

                                        <!-- Concepten: bewaart WELK component per regio gekozen is (geen
                                             gegenereerd bestand) onder App + Pagina, zodat je makkelijker
                                             kunt wisselen/vergelijken dan met losse bestanden in Visual
                                             Studio. Beide keuzelijsten zijn editeerbaar (IsEditable) - een
                                             bestaande naam kiezen laadt 'm, een nieuwe intypen begint een
                                             nieuw concept. Pas als je tevreden bent, zeg je het tegen Claude
                                             om 'm daadwerkelijk in de app te bouwen (zie
                                             Apps/Jabasoft/Hoofdscherm.xaml als voorbeeld). -->
                                        <TextBox Text="CONCEPTEN" Style="{StaticResource SelectableTextStyle}" Foreground="{DynamicResource TextMutedBrush}" FontFamily="{StaticResource AppFontFamily}" FontSize="{StaticResource FontSizeSmall}" Margin="0,24,0,4" />
                                        <TextBox Text="App" Style="{StaticResource SelectableTextStyle}" Foreground="{DynamicResource TextMutedBrush}" FontFamily="{StaticResource AppFontFamily}" FontSize="{StaticResource FontSizeSmall}" Margin="0,0,0,4" />
                                        <ComboBox x:Name="PageDraftAppBox" IsEditable="True" SelectionChanged="PageDraftApp_Changed" LostFocus="PageDraftApp_Changed" Margin="0,0,0,8" />
                                        <TextBox Text="Pagina" Style="{StaticResource SelectableTextStyle}" Foreground="{DynamicResource TextMutedBrush}" FontFamily="{StaticResource AppFontFamily}" FontSize="{StaticResource FontSizeSmall}" Margin="0,0,0,4" />
                                        <ComboBox x:Name="PageDraftPageBox" IsEditable="True" SelectionChanged="PageDraftPage_Changed" LostFocus="PageDraftPage_Changed" Margin="0,0,0,8" />
                                        <Button Click="SavePageDraft_Click" Style="{StaticResource AddComponentButtonStyle}" HorizontalAlignment="Left" AutomationProperties.Name="Concept opslaan">
                                            <TextBlock>
                                                <Run Text="{StaticResource IconSave}" FontFamily="{StaticResource IconFontFamily}" />
                                                <Run Text=" Opslaan" />
                                            </TextBlock>
                                        </Button>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>

                            <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Margin="{StaticResource SpaceMedium}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        ClipToBounds="True">
                                    <!-- Toont ofwel de vijf-regio-samenstelling (LibraryPageBasis,
                                         standaard) ofwel - als App+Pagina een al bestaande, ECHTE
                                         Apps/<App>/<Pagina>.xaml is zonder opgeslagen concept - die
                                         pagina rechtstreeks (zie TryLoadPageDraft). -->
                                    <ContentControl x:Name="LibraryPagePreviewHost">
                                        <controls:Basis x:Name="LibraryPageBasis" Width="1920" Height="1080" />
                                    </ContentControl>
                                </Border>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
