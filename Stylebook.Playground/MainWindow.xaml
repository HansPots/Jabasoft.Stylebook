<Window x:Class="Stylebook.Playground.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:Stylebook.Components.Controls;assembly=Stylebook.Components"
        mc:Ignorable="d"
        Title="Stylebook Playground - tijdelijk, voor componentontwikkeling"
        Height="1080" Width="1920"
        Background="{DynamicResource BackgroundBrush}">

    <!--
        Vaste indeling van het style-venster: links een 256px strook voor
        het menu (welke component/stijl je bekijkt), rechts het style-
        oppervlak zelf waar de daadwerkelijke styling te zien is. De
        definitieve Stylebook-app krijgt dezelfde twee-koloms opzet; dit
        is de tijdelijke, werkende versie ervan.
    -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="256" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Menu-strook -->
        <Border Grid.Column="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <StackPanel Margin="{StaticResource SpaceMedium}">
                <TextBlock Text="MENU"
                           Foreground="{DynamicResource TextMutedBrush}"
                           FontFamily="{StaticResource AppFontFamily}"
                           FontSize="{StaticResource FontSizeSmall}"
                           Margin="0,0,0,16" />
                <!-- Menu-items komen hier, zodra er meerdere secties/componenten zijn om tussen te wisselen. -->
            </StackPanel>
        </Border>

        <!-- Style-oppervlak: hier komt de daadwerkelijke styling/preview te staan -->
        <Grid Grid.Column="1">
            <controls:Basis>
                <controls:Basis.HeaderContent>
                    <TextBlock Text="Header"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontFamily="{StaticResource AppFontFamily}"
                               FontSize="{StaticResource FontSizeTitle}" />
                </controls:Basis.HeaderContent>
                <controls:Basis.MenuContent>
                    <TextBlock Text="Menu"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontFamily="{StaticResource AppFontFamily}"
                               FontSize="{StaticResource FontSizeBody}" />
                </controls:Basis.MenuContent>
                <controls:Basis.ActionContent>
                    <TextBlock Text="Actie"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontFamily="{StaticResource AppFontFamily}"
                               FontSize="{StaticResource FontSizeSmall}"
                               TextWrapping="Wrap"
                               TextAlignment="Center" />
                </controls:Basis.ActionContent>
                <controls:Basis.FooterContent>
                    <TextBlock Text="Footer"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontFamily="{StaticResource AppFontFamily}"
                               FontSize="{StaticResource FontSizeBody}" />
                </controls:Basis.FooterContent>

                <!-- Impliciete child content -> MainContent, zie ContentProperty op Basis -->
                <TextBlock Text="Inhoud"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           FontFamily="{StaticResource AppFontFamily}"
                           FontSize="{StaticResource FontSizeTitle}" />
            </controls:Basis>
        </Grid>
    </Grid>
</Window>
