<Window x:Class="Stylebook.Playground.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:Stylebook.Components.Controls;assembly=Stylebook.Components"
        xmlns:theming="clr-namespace:Stylebook.Components.Theming;assembly=Stylebook.Components"
        mc:Ignorable="d"
        Title="Stylebook Playground - tijdelijk, voor componentontwikkeling"
        Height="1080" Width="1920"
        Background="{DynamicResource BackgroundBrush}">

    <Window.Resources>
        <!-- Gedeelde look voor de inklapbare regio-secties in de menustrook. -->
        <Style TargetType="Expander">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
        </Style>
        <!-- Naam-invoer + toevoegen-knop onderaan elke regio-sectie. -->
        <Style TargetType="TextBox" x:Key="NewComponentNameStyle">
            <Setter Property="Background" Value="{DynamicResource BackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
            <Setter Property="Padding" Value="4" />
        </Style>
        <Style TargetType="Button" x:Key="AddComponentButtonStyle">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="4,0,0,0" />
        </Style>
        <!-- Verwijder-knop: bewust ingetogen (Surface i.p.v. Accent), staat
             alleen naast dezelfde ListBox als de toevoegen/hernoemen-knop. -->
        <Style TargetType="Button" x:Key="DeleteComponentButtonStyle" BasedOn="{StaticResource AddComponentButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        </Style>
    </Window.Resources>

    <!--
        Vaste indeling van het style-venster: links een 256px strook voor
        het menu (welke component/stijl je bekijkt), rechts het style-
        oppervlak zelf waar de daadwerkelijke styling te zien is. De
        definitieve Stylebook-app krijgt dezelfde twee-koloms opzet; dit
        is de tijdelijke, werkende versie ervan.
    -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="256" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Menu-strook -->
        <Border Grid.Column="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="{StaticResource SpaceMedium}">
                    <TextBlock Text="MENU"
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontFamily="{StaticResource AppFontFamily}"
                               FontSize="{StaticResource FontSizeSmall}"
                               Margin="0,0,0,16" />

                    <ComboBox x:Name="ThemePicker"
                              SelectionChanged="ThemePicker_SelectionChanged"
                              Padding="{StaticResource SpaceSmall}"
                              Background="{DynamicResource AccentBrush}"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              FontFamily="{StaticResource AppFontFamily}"
                              FontSize="{StaticResource FontSizeSmall}"
                              Margin="0,0,0,16" />

                    <!-- Componentbeheer per Basis-regio, klap open om de
                         daarin opgeslagen componenten (Stylebook.Data) te
                         zien. Selecteer een component om 'm te hernoemen
                         (naam aanpassen + "+") of te verwijderen ("x");
                         niets geselecteerd + "+" voegt een nieuwe toe. -->
                    <Expander Header="Header">
                        <StackPanel>
                            <ListBox x:Name="HeaderComponents" Tag="Header" DisplayMemberPath="Name" SelectionChanged="Component_SelectionChanged" />
                            <DockPanel Margin="0,8,0,8">
                                <Button Content="x" Tag="Header" Click="DeleteComponent_Click" Style="{StaticResource DeleteComponentButtonStyle}" DockPanel.Dock="Right" />
                                <Button Content="+" Tag="Header" Click="AddComponent_Click" Style="{StaticResource AddComponentButtonStyle}" DockPanel.Dock="Right" />
                                <TextBox x:Name="HeaderNewComponentName" Tag="Header" KeyDown="NewComponentName_KeyDown" Style="{StaticResource NewComponentNameStyle}" />
                            </DockPanel>
                        </StackPanel>
                    </Expander>
                    <Expander Header="Menu">
                        <StackPanel>
                            <ListBox x:Name="MenuComponents" Tag="Menu" DisplayMemberPath="Name" SelectionChanged="Component_SelectionChanged" />
                            <DockPanel Margin="0,8,0,8">
                                <Button Content="x" Tag="Menu" Click="DeleteComponent_Click" Style="{StaticResource DeleteComponentButtonStyle}" DockPanel.Dock="Right" />
                                <Button Content="+" Tag="Menu" Click="AddComponent_Click" Style="{StaticResource AddComponentButtonStyle}" DockPanel.Dock="Right" />
                                <TextBox x:Name="MenuNewComponentName" Tag="Menu" KeyDown="NewComponentName_KeyDown" Style="{StaticResource NewComponentNameStyle}" />
                            </DockPanel>
                        </StackPanel>
                    </Expander>
                    <Expander Header="Inhoud">
                        <StackPanel>
                            <ListBox x:Name="InhoudComponents" Tag="Inhoud" DisplayMemberPath="Name" SelectionChanged="Component_SelectionChanged" />
                            <DockPanel Margin="0,8,0,8">
                                <Button Content="x" Tag="Inhoud" Click="DeleteComponent_Click" Style="{StaticResource DeleteComponentButtonStyle}" DockPanel.Dock="Right" />
                                <Button Content="+" Tag="Inhoud" Click="AddComponent_Click" Style="{StaticResource AddComponentButtonStyle}" DockPanel.Dock="Right" />
                                <TextBox x:Name="InhoudNewComponentName" Tag="Inhoud" KeyDown="NewComponentName_KeyDown" Style="{StaticResource NewComponentNameStyle}" />
                            </DockPanel>
                        </StackPanel>
                    </Expander>
                    <Expander Header="Actie">
                        <StackPanel>
                            <ListBox x:Name="ActieComponents" Tag="Actie" DisplayMemberPath="Name" SelectionChanged="Component_SelectionChanged" />
                            <DockPanel Margin="0,8,0,8">
                                <Button Content="x" Tag="Actie" Click="DeleteComponent_Click" Style="{StaticResource DeleteComponentButtonStyle}" DockPanel.Dock="Right" />
                                <Button Content="+" Tag="Actie" Click="AddComponent_Click" Style="{StaticResource AddComponentButtonStyle}" DockPanel.Dock="Right" />
                                <TextBox x:Name="ActieNewComponentName" Tag="Actie" KeyDown="NewComponentName_KeyDown" Style="{StaticResource NewComponentNameStyle}" />
                            </DockPanel>
                        </StackPanel>
                    </Expander>
                    <Expander Header="Footer">
                        <StackPanel>
                            <ListBox x:Name="FooterComponents" Tag="Footer" DisplayMemberPath="Name" SelectionChanged="Component_SelectionChanged" />
                            <DockPanel Margin="0,8,0,8">
                                <Button Content="x" Tag="Footer" Click="DeleteComponent_Click" Style="{StaticResource DeleteComponentButtonStyle}" DockPanel.Dock="Right" />
                                <Button Content="+" Tag="Footer" Click="AddComponent_Click" Style="{StaticResource AddComponentButtonStyle}" DockPanel.Dock="Right" />
                                <TextBox x:Name="FooterNewComponentName" Tag="Footer" KeyDown="NewComponentName_KeyDown" Style="{StaticResource NewComponentNameStyle}" />
                            </DockPanel>
                        </StackPanel>
                    </Expander>
                    <Expander Header="Algemeen">
                        <StackPanel>
                            <ListBox x:Name="AlgemeenComponents" Tag="Algemeen" DisplayMemberPath="Name" SelectionChanged="Component_SelectionChanged" />
                            <DockPanel Margin="0,8,0,8">
                                <Button Content="x" Tag="Algemeen" Click="DeleteComponent_Click" Style="{StaticResource DeleteComponentButtonStyle}" DockPanel.Dock="Right" />
                                <Button Content="+" Tag="Algemeen" Click="AddComponent_Click" Style="{StaticResource AddComponentButtonStyle}" DockPanel.Dock="Right" />
                                <TextBox x:Name="AlgemeenNewComponentName" Tag="Algemeen" KeyDown="NewComponentName_KeyDown" Style="{StaticResource NewComponentNameStyle}" />
                            </DockPanel>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Style-oppervlak: hier komt de daadwerkelijke styling/preview te
             staan. Eigen Resources met een eigen Themes/*.xaml - los van
             de vaste Visual Studio-look van de tool zelf (zie App.xaml) -
             zodat alleen dit gebied van thema wisselt. -->
        <Grid x:Name="StylePreviewArea" Grid.Column="1">
            <Grid.Resources>
                <ResourceDictionary>
                    <ResourceDictionary.MergedDictionaries>
                        <ResourceDictionary Source="pack://application:,,,/Stylebook.Components;component/Styles/Themes/Lcars.xaml" />
                    </ResourceDictionary.MergedDictionaries>
                </ResourceDictionary>
            </Grid.Resources>
            <controls:Basis>
                <controls:Basis.HeaderContent>
                    <TextBlock Text="Header"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontFamily="{StaticResource AppFontFamily}"
                               FontSize="{StaticResource FontSizeTitle}" />
                </controls:Basis.HeaderContent>
                <controls:Basis.MenuContent>
                    <TextBlock Text="Menu"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontFamily="{StaticResource AppFontFamily}"
                               FontSize="{StaticResource FontSizeBody}" />
                </controls:Basis.MenuContent>
                <controls:Basis.ActionContent>
                    <TextBlock Text="Actie"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontFamily="{StaticResource AppFontFamily}"
                               FontSize="{StaticResource FontSizeSmall}"
                               TextWrapping="Wrap"
                               TextAlignment="Center" />
                </controls:Basis.ActionContent>
                <controls:Basis.FooterContent>
                    <TextBlock Text="Footer"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontFamily="{StaticResource AppFontFamily}"
                               FontSize="{StaticResource FontSizeBody}" />
                </controls:Basis.FooterContent>

                <!-- Impliciete child content -> MainContent, zie ContentProperty op Basis -->
                <TextBlock Text="Inhoud"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           FontFamily="{StaticResource AppFontFamily}"
                           FontSize="{StaticResource FontSizeTitle}" />
            </controls:Basis>
        </Grid>
    </Grid>
</Window>
