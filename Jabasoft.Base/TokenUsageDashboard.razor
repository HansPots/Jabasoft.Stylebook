@* ============================================================
   TokenUsageDashboard — shared token-usage view, embeddable by any
   JabaSoft app, Blazor Server or Blazor Hybrid alike (see Jabasoft's
   own BlazorWebView-hosted usage). Pass Application to show just that
   app's own usage (e.g. TabStudio, LocalAiStudio); leave it null to
   show every app (Jabasoft's cross-app overview).
   ============================================================ *@
@using Shared.Telemetry
@inject ITokenUsageRepository TokenUsageRepository

<div class="token-usage-dashboard">
    @if (_entries is null)
    {
        <p>Laden...</p>
    }
    else if (_entries.Count == 0)
    {
        <p>Nog geen geregistreerd tokenverbruik@(Application is null ? "" : $" voor {Application}").</p>
    }
    else
    {
        <table>
            <thead>
                <tr>
                    @if (Application is null)
                    {
                        <th>App</th>
                    }
                    <th>Tijdstip</th>
                    <th>Model</th>
                    <th>Prompt</th>
                    <th>Completion</th>
                    <th>Totaal</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var entry in _entries.OrderByDescending(e => e.Timestamp))
                {
                    <tr>
                        @if (Application is null)
                        {
                            <td>@entry.Application</td>
                        }
                        <td>@entry.Timestamp.LocalDateTime.ToString("g")</td>
                        <td>@(entry.Model ?? "-")</td>
                        <td>@entry.PromptTokens</td>
                        <td>@entry.CompletionTokens</td>
                        <td>@entry.TotalTokens</td>
                    </tr>
                }
                <tr class="app-total">
                    <td colspan="@(Application is null ? 4 : 3)">Totaal</td>
                    <td>@_entries.Sum(e => e.PromptTokens)</td>
                    <td>@_entries.Sum(e => e.CompletionTokens)</td>
                    <td>@_entries.Sum(e => e.TotalTokens)</td>
                </tr>
            </tbody>
        </table>
    }
</div>

@code {
    /// <summary>App name to filter on (e.g. "TabStudio"). Null shows every app.</summary>
    [Parameter] public string? Application { get; set; }

    /// <summary>How far back to show usage for. Defaults to the last 30 days.</summary>
    [Parameter] public TimeSpan Lookback { get; set; } = TimeSpan.FromDays(30);

    private IReadOnlyList<TokenUsageEntry>? _entries;

    protected override async Task OnInitializedAsync()
    {
        var since = DateTimeOffset.UtcNow - Lookback;
        _entries = Application is null
            ? await TokenUsageRepository.GetAllEntriesAsync(since, CancellationToken.None)
            : await TokenUsageRepository.GetEntriesAsync(Application, since, CancellationToken.None);
    }
}
