<UserControl x:Class="Stylebook.Components.Controls.Card"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="280" d:DesignHeight="140"
             d:Title="Card titel">

    <!--
        d:Title hierboven: als je DIT bestand zelf in de Designer opent
        (de definitie van Card bewerkt), roept die geen "new Card()" aan -
        de constructor's Title/Body-standaardwaarden (Card.xaml.cs) gelden
        dus niet hier, alleen wanneer iemand ANDERS <controls:Card/>
        gebruikt (bv. Bibliotheek's Activator.CreateInstance, of een
        andere pagina). d:Title is de design-time-only tegenhanger die WEL
        geldt terwijl je dit bestand bewerkt - mc:Ignorable="d" laat 'm
        bij het echt compileren/draaien gewoon wegvallen. Geen d:Body:
        Body is object-typed (voor willekeurige inhoud), en de Designer
        accepteert dat niet als platte tekst-attribuutwaarde zoals bij
        Title (string) - de Body-kant van de preview blijft dus leeg
        totdat je 'm hier zelf invult.
    -->

    <!-- Design-time-only: geeft Visual Studio/Blend's Designer een
         thema-context (kleuren, lettertype) - deze class library heeft
         zelf geen App.xaml die dat normaal doet. mc:Ignorable="d" zorgt
         dat dit bij het echt compileren/draaien volledig wegvalt. -->
    <d:UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Stylebook.Components;component/Styles/Theme.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Stylebook.Components;component/Styles/Themes/Lcars.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </d:UserControl.Resources>

    <!--
        First reusable component: a titled card with an arbitrary content
        area. Demonstrates the two ways a component takes "content" from
        whoever uses it, instead of hardcoding text:

          - Title: a DependencyProperty (below, in Card.xaml.cs) - bind it
            like <controls:Card Title="{Binding SomeText}" /> or just
            Title="Literal text". Same idea as a Razor @Title parameter.

          - Everything between <controls:Card>...</controls:Card> tags -
            arbitrary WPF content (text, another component, a whole
            layout), routed to the Body property (see Card.xaml.cs) and
            rendered by the ContentPresenter below. Same idea as Razor's
            @ChildContent / a Blazor RenderFragment, or a web component's
            <slot>.

        Colors/spacing all come from {DynamicResource ...} pointing at
        Styles/Colors.xaml + Typography.xaml - never a literal value here,
        so the whole family's look changes by editing those two files, not
        this one.
    -->

    <Border Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusMedium}"
            Padding="{StaticResource SpaceMedium}">
        <StackPanel>
            <TextBox Text="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}"
                     Style="{StaticResource SelectableTextStyle}"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     FontFamily="{StaticResource AppFontFamily}"
                     FontSize="{StaticResource FontSizeTitle}"
                     FontWeight="SemiBold"
                     Margin="0,0,0,8" />
            <ContentPresenter Content="{Binding Body, RelativeSource={RelativeSource AncestorType=UserControl}}" />
        </StackPanel>
    </Border>

</UserControl>
