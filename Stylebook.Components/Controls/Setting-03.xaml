<UserControl x:Class="Stylebook.Components.Controls.Setting03"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">

    <!-- Design-time-only: geeft Visual Studio/Blend's Designer een
         thema-context (kleuren, lettertype) - deze class library heeft
         zelf geen App.xaml die dat normaal doet. mc:Ignorable="d" zorgt
         dat dit bij het echt compileren/draaien volledig wegvalt. -->
    <d:UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Stylebook.Components;component/Styles/Theme.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Stylebook.Components;component/Styles/Themes/Lcars.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </d:UserControl.Resources>

    <!--
        Instellingenkaart 3 van 3: REFRESH TIME. Hoe vaak de meterpillen in
        de footer (Footer-02 CPU, Footer-03 RAM, Footer-04 MODEL VRAM) hun
        waarde opnieuw ophalen.

        Zelfde breedte (1568) en kaartopmaak als kaart 1 en 2, en dezelfde
        gedeelde stijlen voor de schuifbalk en de knop.

        Bereik 1-60 seconden met de standaard op 5. IntervalLabel en
        IntervalSlider hebben een naam, zodat ze later vanuit code-behind
        aan de echte instelling gekoppeld kunnen worden.
    -->
    <Border Width="1568" CornerRadius="6" BorderThickness="1"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            HorizontalAlignment="Left" VerticalAlignment="Top">
        <StackPanel Margin="20,16">
            <TextBlock Text="REFRESH TIME" FontSize="{DynamicResource FontSizeTitle}" FontWeight="SemiBold"
                       Foreground="{DynamicResource Text01Brush}" />

            <TextBlock x:Name="IntervalLabel" Text="Footer refresh time (CPU/RAM/Model VRAM) &#8212; 5 sec"
                       Margin="0,14,0,6" FontSize="{DynamicResource FontSizeSmall}"
                       Foreground="{DynamicResource TextMutedBrush}" />
            <Slider x:Name="IntervalSlider" Minimum="1" Maximum="60" Value="5"
                    Style="{DynamicResource SliderAccentStyle}" />

            <Button x:Name="ResetIntervalButton" Content="Reset to default (5 sec)"
                    Margin="0,16,0,0" Style="{DynamicResource AccentButtonStyle}" />
        </StackPanel>
    </Border>

</UserControl>
