<UserControl x:Class="Stylebook.Components.Controls.HeaderGradientBar03"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:theming="clr-namespace:Stylebook.Components.Theming"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">

    <!-- Design-time-only: geeft Visual Studio/Blend's Designer een
         thema-context (kleuren, lettertype) - deze class library heeft
         zelf geen App.xaml die dat normaal doet. mc:Ignorable="d" zorgt
         dat dit bij het echt compileren/draaien volledig wegvalt. -->
    <d:UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Stylebook.Components;component/Styles/Theme.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Stylebook.Components;component/Styles/Themes/Lcars.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </d:UserControl.Resources>

    <!-- Variant van HeaderGradientBar-01 met een balkhoogte van 36 in
         plaats van 48 - de maat die de oude webshell ook gebruikte
         (shell-header.css: de signaalstrook is 36px hoog binnen een
         44px-rij).

         De bocht linksboven is nog steeds een echte ring-vorm, gedraaid
         om het hoekpunt (96,96): een kwartrond met buitenstraal 96 en
         daarin een kwartrond met binnenstraal 60 uitgesneden via
         FillRule="EvenOdd". Het verschil (96-60=36) is precies de
         bandbreedte, dus de band is overal even dik en loopt naadloos
         over in de horizontale balk (hoogte 36) en de neergaande poot
         (breedte 36).

         Let op: hier staat GEEN letterlijke CornerRadius op de balk.
         Die zou na CornerRadiusParts.TopRight worden toegepast en de
         ronde rechterkant platdrukken - zie HeaderGradientBar-01/-02,
         waar dat wel gebeurt. -->
    <Grid Width="Auto" Height="Auto" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Viewbox>
            <Canvas Width="696" Height="200">
                <Path Fill="{DynamicResource HeaderGradientStartBrush}"
                      Canvas.Left="0" Canvas.Top="0">
                    <Path.Data>
                        <PathGeometry FillRule="EvenOdd">
                            <PathFigure StartPoint="96,0" IsClosed="True">
                                <ArcSegment Point="0,96" Size="96,96" IsLargeArc="False" SweepDirection="Counterclockwise" />
                                <LineSegment Point="96,96" />
                            </PathFigure>
                            <PathFigure StartPoint="96,36" IsClosed="True">
                                <ArcSegment Point="36,96" Size="60,60" IsLargeArc="False" SweepDirection="Counterclockwise" />
                                <LineSegment Point="96,96" />
                            </PathFigure>
                        </PathGeometry>
                    </Path.Data>
                </Path>

                <Border theming:CornerRadiusParts.TopLeft="0"
                        theming:CornerRadiusParts.TopRight="0"
                        theming:CornerRadiusParts.BottomRight="0"
                        theming:CornerRadiusParts.BottomLeft="0"
                        Background="{DynamicResource HeaderGradientStartBrush}" Canvas.Top="96"
                        Width="36" Height="104" />

                <Border theming:CornerRadiusParts.TopLeft="0"
                        theming:CornerRadiusParts.TopRight="{DynamicResource RadiusBar}"
                        theming:CornerRadiusParts.BottomRight="0"
                        theming:CornerRadiusParts.BottomLeft="0"
                        Canvas.Left="96"
                        Width="600" Height="36">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                            <LinearGradientBrush.GradientStops>
                                <GradientStop Color="{DynamicResource HeaderGradientStartColor}" Offset="0" />
                                <GradientStop Color="{DynamicResource HeaderGradientMidColor}" Offset="0.45" />
                                <GradientStop Color="{DynamicResource HeaderGradientEndColor}" Offset="1" />
                            </LinearGradientBrush.GradientStops>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
            </Canvas>
        </Viewbox>
    </Grid>

</UserControl>
