<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Spacing scale - the WPF equivalent of jabasoft-theme.css's
         lcars-space base unit. Declared as Thickness (not a plain
         number): Padding/Margin properties need a Thickness, and
         {StaticResource} hands the resource object straight to the
         property without running the string-to-Thickness conversion a
         literal like Padding="16" gets for free - so a Double resource
         here throws at runtime ('16' is not a valid value for property
         'Padding') instead of silently working. Uniform on all 4 sides;
         add a *_Thickness variant with its own value if a component ever
         needs asymmetric spacing. -->
    <Thickness x:Key="SpaceXSmall">4</Thickness>
    <Thickness x:Key="SpaceSmall">8</Thickness>
    <Thickness x:Key="SpaceMedium">16</Thickness>
    <Thickness x:Key="SpaceLarge">24</Thickness>

    <!--
        De zwarte rand die Basis.xaml om elk van de vijf blokken legt
        (header, menu, inhoud, actie, footer). Hier staat alleen de
        STANDAARD (0 = blokken tegen elkaar aan); de SPACING-kaart op het
        instellingenscherm zet er een andere waarde overheen met
        LayoutManager.ApplyRegionGap.

        Dat overzetten gebeurt door de sleutel rechtstreeks in een
        hogergelegen ResourceDictionary te zetten - die wint dan van deze
        standaard, want een DynamicResource kijkt eerst naar de eigen
        vermeldingen van een dictionary en pas daarna in zijn
        MergedDictionaries. Vandaar dat dit hier gewoon kan blijven staan,
        ook al wordt Typography.xaml zelf nooit omgewisseld.
    -->
    <Thickness x:Key="RegionGapThickness">6</Thickness>

    <!--
        Afgeleiden van dezelfde SPACING-waarde, met ruimte aan maar EEN of
        TWEE kanten. Het principe: elk onderdeel geeft ruimte aan zijn
        linker- en/of bovenkant, nooit aan de kant waar de buur al ruimte
        geeft. Anders brengen twee buren allebei een marge mee en zie je het
        dubbele van wat je instelt.

        De onderste en rechterrand van de pagina heeft geen buur die het kan
        doen; daarvoor is RegionGapEndThickness, als opvulling om het geheel.
    -->
    <Thickness x:Key="RegionGapLeftTopThickness">6,6,0,0</Thickness>
    <Thickness x:Key="RegionGapTopThickness">0,6,0,0</Thickness>
    <Thickness x:Key="RegionGapLeftThickness">6,0,0,0</Thickness>
    <Thickness x:Key="RegionGapRightThickness">0,0,6,0</Thickness>
    <Thickness x:Key="RegionGapEndThickness">0,0,6,6</Thickness>

    <!-- Dezelfde waarde als los getal, voor wie een hoogte of breedte moet
         zetten in plaats van een marge. -->
    <sys:Double x:Key="RegionGapSize">6</sys:Double>

    <!--
        De dikte van de kaderrand om de instellingenkaarten en de
        infoblokken. Hier de STANDAARD (2); de BORDER-kaart op het
        instellingenscherm zet er een andere waarde overheen met
        LayoutManager.ApplyRegionBorder, op dezelfde manier als SPACING.

        RegionBorderInnerRadius hoort erbij: de titelbalk binnen een
        infoblok moet een hoekstraal hebben van de BUITENstraal min de
        randdikte, anders zie je in de bovenhoeken een kiertje tussen de
        rand en de balk. Die wordt dus meeberekend.
    -->
    <Thickness x:Key="RegionBorderThickness">3</Thickness>
    <CornerRadius x:Key="RegionBorderInnerRadius">3,3,0,0</CornerRadius>

    <FontFamily x:Key="AppFontFamily">Segoe UI</FontFamily>
    <sys:Double x:Key="FontSizeSmall">12</sys:Double>
    <sys:Double x:Key="FontSizeBody">14</sys:Double>
    <sys:Double x:Key="FontSizeTitle">18</sys:Double>

    <!-- Het lettertype van het BEELDMERK (Controls/JabaSoftWordmark), niet
         van de interface. Staat hier los van AppFontFamily en moet dat ook
         blijven: een logo is een vaste vorm, die hoort niet mee te wisselen
         met de lettertype-instelling van de gebruiker (zie de FONT-kaart in
         Instellingen). Wie het app-lettertype omzet, laat deze dus staan.

         Dezelfde naam als AppFontFamily nu toevallig heeft - dat is geen
         reden om ze samen te voegen; ze veranderen om verschillende
         redenen. De maatvoering van het beeldmerk (48/36/12 px en de
         uitgemeten marges in dat bestand) is op Segoe UI uitgelijnd. -->
    <FontFamily x:Key="LogoFontFamily">Segoe UI</FontFamily>

    <!-- Google Material Symbols (Outlined), Apache 2.0 - embedded als WPF
         pack-resource (zie Fonts/MaterialSymbolsOutlined.ttf en
         Stylebook.Components.csproj), niet van een CDN: dit is een
         desktop-app zonder <link>-achtige webfont-lading. Elk icoon is één
         teken op zijn Private-Use-Area codepoint - de namen/codes komen
         rechtstreeks uit het font-eigen .codepoints-bestand
         (github.com/google/material-design-icons). Nieuw icoon nodig?
         Zoek de naam op in dat bestand en zet 'm hier als
         IconXxx="&#xCODE;" bij, in plaats van de entity ad-hoc ergens in
         de XAML te typen. -->
    <FontFamily x:Key="IconFontFamily">pack://application:,,,/Stylebook.Components;component/Fonts/#Material Symbols Outlined</FontFamily>
    <sys:String x:Key="IconPage">&#xE873;</sys:String>
    <sys:String x:Key="IconWidgets">&#xE1BD;</sys:String>
    <sys:String x:Key="IconPalette">&#xE40A;</sys:String>
    <sys:String x:Key="IconAdd">&#xE145;</sys:String>
    <sys:String x:Key="IconDelete">&#xE92E;</sys:String>
    <sys:String x:Key="IconSave">&#xE161;</sys:String>
    <sys:String x:Key="IconAutoAwesome">&#xE65F;</sys:String>
    <sys:String x:Key="IconCheck">&#xE668;</sys:String>
    <sys:String x:Key="IconClose">&#xE5CD;</sys:String>
    <sys:String x:Key="IconDashboard">&#xE871;</sys:String>
    <sys:String x:Key="IconRefresh">&#xE5D5;</sys:String>
    <sys:String x:Key="IconEdit">&#xE3C9;</sys:String>
    <sys:String x:Key="IconLayers">&#xE53B;</sys:String>
    <sys:String x:Key="IconSettings">&#xE8B8;</sys:String>

    <!-- De hoekronding-schaal staat NIET meer hier maar per thema, in
         Styles/Themes/*.xaml: LCARS is rond, Visual Studio is overal recht
         (alles 0). Een ronding is dus iets van het thema geworden, net als
         een kleur - stond hij hier, dan zou hij voor beide thema's gelijk
         zijn. Zelfde discipline als de spacing-schaal hierboven: een
         genoemde maat kiezen i.p.v. CornerRadius="6" op elk component
         apart hardcoden. -->

</ResourceDictionary>
