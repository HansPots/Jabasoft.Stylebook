<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        LCARS thema - de Star Trek-console-look (zwarte achtergrond,
        amberoranje accent/tekst, lila randen), Jabasoft's oorspronkelijke
        merkidentiteit uit het oude jabasoft-theme.css. Zelfde sleutel-set
        als VisualStudio.xaml - componenten refereren nooit rechtstreeks
        naar een thema, alleen naar deze gedeelde namen via
        {DynamicResource ...}.
    -->

    <Color x:Key="AccentColor">#FF9900</Color>
    <Color x:Key="AccentColorDark">#CC7A00</Color>
    <Color x:Key="BackgroundColor">#000000</Color>
    <!-- Zwart, gelijk aan BackgroundColor: in LCARS is het hele vlak zwart.
         De blokken van Basis (header, menu, inhoud, actie, footer) lopen
         daardoor naadloos in elkaar over - de scheiding komt van de
         SPACING-instelling, niet van een kleurverschil of een randlijn. -->
    <Color x:Key="SurfaceColor">#000000</Color>
    <Color x:Key="BorderColor">#9999CC</Color>
    <Color x:Key="TextPrimaryColor">#FF9900</Color>
    <Color x:Key="TextMutedColor">#CC6666</Color>
    <!-- Puur wit, bewust hetzelfde in beide thema's (geen per-thema
         variant) - voor tekst die altijd wit moet zijn, ongeacht thema. -->
    <Color x:Key="Text01Color">#FFFFFF</Color>
    <!-- Tekst/iconen BOVENOP een AccentBrush-achtergrond (knoppen,
         actieve tab) - authentieke LCARS-look is zwarte tekst op de
         oranje vlakken, niet oranje-op-oranje (TextPrimaryColor is hier
         gelijk aan AccentColor, dus die twee mogen nooit samen als
         achtergrond+voorgrond gebruikt worden). -->
    <Color x:Key="AccentForegroundColor">#000000</Color>

    <!-- Header-regio gradiënten (HpoHeader e.a.) - zelfde waarden als de
         database-tokens van hetzelfde thema (zie DesignTokens-tabel),
         hier ook statisch beschikbaar zodat een app zonder live
         database-verbinding (elke app behalve Stylebook.Playground) ze
         ook kan resolven. -->
    <Color x:Key="HeaderGradientStartColor">#FFB16C</Color>
    <Color x:Key="HeaderGradientMidColor">#FF8066</Color>
    <Color x:Key="HeaderGradientEndColor">#B63C50</Color>
    <Color x:Key="HeaderSideGradientStartColor">#8E89FF</Color>
    <Color x:Key="HeaderSideGradientEndColor">#7774F5</Color>

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentBrushDark" Color="{StaticResource AccentColorDark}" />
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="Text01Brush" Color="{StaticResource Text01Color}" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="{StaticResource AccentForegroundColor}" />
    <SolidColorBrush x:Key="HeaderGradientStartBrush" Color="{StaticResource HeaderGradientStartColor}" />
    <SolidColorBrush x:Key="HeaderGradientMidBrush" Color="{StaticResource HeaderGradientMidColor}" />
    <SolidColorBrush x:Key="HeaderGradientEndBrush" Color="{StaticResource HeaderGradientEndColor}" />
    <SolidColorBrush x:Key="HeaderSideGradientStartBrush" Color="{StaticResource HeaderSideGradientStartColor}" />
    <SolidColorBrush x:Key="HeaderSideGradientEndBrush" Color="{StaticResource HeaderSideGradientEndColor}" />

    <!--
        Hoekronding-schaal. Stond eerder in Typography.xaml en was daarmee
        voor beide thema's gelijk; een ronding hoort bij de look, dus hij
        staat nu per thema. LCARS is rond, Visual Studio overal recht.

        RadiusBar en RadiusElbow zijn de grote LCARS-vormen: de ronde kop
        van de kleurbalk in de header, en de elleboogjes en het menublok.
    -->
    <CornerRadius x:Key="RadiusSmall">3</CornerRadius>
    <CornerRadius x:Key="RadiusMedium">6</CornerRadius>
    <CornerRadius x:Key="RadiusLarge">12</CornerRadius>
    <CornerRadius x:Key="RadiusXLarge">18</CornerRadius>
    <CornerRadius x:Key="RadiusXXLarge">24</CornerRadius>
    <CornerRadius x:Key="RadiusBar">36</CornerRadius>
    <CornerRadius x:Key="RadiusElbow">48</CornerRadius>

    <!--
        De drie kleuren van het bolletje in de SYSTEM HEALTH-pil: groen als
        alles klaarstaat, oranje tijdens het controleren, rood bij een fout.
        Per thema, want ze moeten leesbaar zijn op de achtergrond van dat
        thema - en oranje moet niet wegvallen tegen het accent.
    -->
    <Color x:Key="HealthOkColor">#66CC66</Color>
    <Color x:Key="HealthBusyColor">#FF9900</Color>
    <Color x:Key="HealthErrorColor">#CC4444</Color>

    <SolidColorBrush x:Key="HealthOkBrush" Color="{StaticResource HealthOkColor}" />
    <SolidColorBrush x:Key="HealthBusyBrush" Color="{StaticResource HealthBusyColor}" />
    <SolidColorBrush x:Key="HealthErrorBrush" Color="{StaticResource HealthErrorColor}" />

</ResourceDictionary>
