<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        The single entry point every consuming app merges in - the WPF
        equivalent of linking jabasoft-theme.css. Consuming an app just
        needs:

            <Application.Resources>
                <ResourceDictionary>
                    <ResourceDictionary.MergedDictionaries>
                        <ResourceDictionary Source="pack://application:,,,/Stylebook.Components;component/Styles/Theme.xaml" />
                    </ResourceDictionary.MergedDictionaries>
                </ResourceDictionary>
            </Application.Resources>

        New shared Style for a control (see Controls/*.xaml) gets added
        here as another MergedDictionary entry - never copy a Style's XAML
        into an app itself, same discipline as the old shared *.css files.
    -->

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Colors.xaml" />
        <ResourceDictionary Source="Typography.xaml" />
    </ResourceDictionary.MergedDictionaries>

</ResourceDictionary>
