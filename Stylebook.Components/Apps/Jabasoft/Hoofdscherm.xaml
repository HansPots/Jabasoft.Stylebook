<UserControl x:Class="Stylebook.Components.Apps.Jabasoft.Hoofdscherm"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Stylebook.Components.Controls"
             xmlns:header="clr-namespace:Stylebook.Components.Regions.Header"
             xmlns:footer="clr-namespace:Stylebook.Components.Regions.Footer"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="1920" d:DesignHeight="1080">

    <!-- Design-time-only: geeft Visual Studio/Blend's Designer een
         thema-context (kleuren, lettertype) - deze class library heeft
         zelf geen App.xaml die dat normaal doet. mc:Ignorable="d" zorgt
         dat dit bij het echt compileren/draaien volledig wegvalt. -->
    <d:UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Stylebook.Components;component/Styles/Theme.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Stylebook.Components;component/Styles/Themes/Lcars.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </d:UserControl.Resources>

    <!--
        De opgeslagen paginacompositie voor Jabasoft's hoofdscherm - een
        Basis met Header/Footer al ingevuld met de echte, gemigreerde
        componenten (HpoHeader/Footerbalk). Menu/Inhoud/Actie zijn BEWUST
        niet gebakken: in de echte, draaiende Jabasoft.App zijn dat de
        FUNCTIONELE app-launcherlijst en de instellingen-knop (code-
        behind, zie Jabasoft.App/MainWindow.xaml.cs) - dit component geeft
        die drie slots gewoon door aan zijn eigen MenuContent/MainContent/
        ActionContent-properties, precies zoals Basis zelf al werkt.

        Bestaat vooral zodat Stylebook.Playground dit hoofdscherm kan
        tonen/beoordelen zonder een projectverwijzing naar Jabasoft.App
        nodig te hebben - zie idempotent-sauteeing-valley.md.
    -->
    <controls:Basis x:Name="Shell">
        <controls:Basis.HeaderContent>
            <header:HpoHeader />
        </controls:Basis.HeaderContent>
        <controls:Basis.FooterContent>
            <footer:Footerbalk />
        </controls:Basis.FooterContent>
    </controls:Basis>

</UserControl>
