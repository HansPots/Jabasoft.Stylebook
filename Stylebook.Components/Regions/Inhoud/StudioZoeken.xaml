<UserControl x:Class="Stylebook.Components.Regions.Inhoud.StudioZoeken"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="1616" d:DesignHeight="805">

    <!-- Design-time-only: geeft Visual Studio/Blend's Designer een
         thema-context (kleuren, lettertype) - deze class library heeft
         zelf geen App.xaml die dat normaal doet. mc:Ignorable="d" zorgt
         dat dit bij het echt compileren/draaien volledig wegvalt. -->
    <d:UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Stylebook.Components;component/Styles/Theme.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Stylebook.Components;component/Styles/Themes/Lcars.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </d:UserControl.Resources>

    <!--
        Inhoud-regio component: het scherm ZOEKEN van LocalAiStudio, om te
        stylen.

        NOG LEEG: alleen een kop en een regel die zegt waar het scherm voor
        is. De kaartopmaak eromheen (schuifvak, marges die met de
        SPACING-instelling meelopen) staat er al, zodat wat je erin zet
        meteen goed in de pagina valt.

        Dit is het kijkexemplaar. De uitvoering die echt draait staat in
        LocalAiStudio.App/Regios/Inhoud - wat je hier maakt, vertel je door
        zodat het daar overgenomen wordt.
    -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="{DynamicResource RegionGapRightThickness}">
            <Border MinWidth="480" CornerRadius="{DynamicResource RadiusMedium}" BorderThickness="{DynamicResource RegionBorderThickness}"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    HorizontalAlignment="Stretch" VerticalAlignment="Top">
                <StackPanel Margin="20,16">
                    <TextBlock Text="ZOEKEN"
                               FontSize="{DynamicResource FontSizeTitle}" FontWeight="SemiBold"
                               Foreground="{DynamicResource Text01Brush}" />
                    <TextBlock Text="Zoeken door het gekozen project." Margin="0,8,0,0" TextWrapping="Wrap"
                               FontSize="{DynamicResource FontSizeSmall}"
                               Foreground="{DynamicResource TextMutedBrush}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>

</UserControl>
