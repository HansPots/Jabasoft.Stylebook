<UserControl x:Class="Stylebook.Components.Regions.Inhoud.Instellingen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Stylebook.Components.Controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">

    <!-- Design-time-only: geeft Visual Studio/Blend's Designer een
         thema-context (kleuren, lettertype) - deze class library heeft
         zelf geen App.xaml die dat normaal doet. mc:Ignorable="d" zorgt
         dat dit bij het echt compileren/draaien volledig wegvalt. -->
    <d:UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Stylebook.Components;component/Styles/Theme.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Stylebook.Components;component/Styles/Themes/Lcars.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </d:UserControl.Resources>

    <!--
        Inhoud-regio component: Jabasoft.App's instellingenscherm (achter
        de instellingen-knop in de Actie-rail, zie MainWindow.xaml.cs's
        ToggleSettings). Vroeger via XamlReader.Parse live uit de database
        gelezen door SettingsView, nu een echt, gecompileerd component dat
        SettingsView rechtstreeks host.

        Dit component IS de instellingenpagina van Jabasoft: het stapelt de
        drie losse kaarten uit Controls/ (Setting-01 THEMA, Setting-02 FONT,
        Setting-03 REFRESH TIME) onder elkaar. Een kaart erbij of eraf is
        dus één regel hier, de kaart zelf blijft op zichzelf te bekijken in
        de Controls-modus van het Stylebook.

        ScrollViewer eromheen omdat de kaarten een vaste breedte van 1568
        hebben (de Inhoud-basis van 1616 met 24 marge): staat het venster
        smaller, dan schuift het mee in plaats van weg te vallen.
    -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <controls:Setting01 />
            <controls:Setting02 Margin="0,16,0,0" />
            <controls:Setting03 Margin="0,16,0,0" />
        </StackPanel>
    </ScrollViewer>

</UserControl>
