<UserControl x:Class="Stylebook.Components.Regions.Inhoud.Instellingen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">

    <!-- Design-time-only: geeft Visual Studio/Blend's Designer een
         thema-context (kleuren, lettertype) - deze class library heeft
         zelf geen App.xaml die dat normaal doet. mc:Ignorable="d" zorgt
         dat dit bij het echt compileren/draaien volledig wegvalt. -->
    <d:UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Stylebook.Components;component/Styles/Theme.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Stylebook.Components;component/Styles/Themes/Lcars.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </d:UserControl.Resources>

    <!--
        Inhoud-regio component: Jabasoft.App's instellingenscherm (achter
        de instellingen-knop in de Actie-rail, zie MainWindow.xaml.cs's
        ToggleSettings). Nog een lege placeholder - vroeger via
        XamlReader.Parse live uit de database gelezen door SettingsView,
        nu een echt, gecompileerd component dat SettingsView rechtstreeks
        host.
    -->
    <Grid>
        <TextBox Text="Instellingen - nog niets hier."
                 Style="{DynamicResource SelectableTextStyle}"
                 Foreground="{DynamicResource TextMutedBrush}"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center" />
    </Grid>

</UserControl>
