<UserControl x:Class="Stylebook.Components.Regions.Menu.StudioMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:theming="clr-namespace:Stylebook.Components.Theming"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" MinHeight="400"
             d:DesignWidth="256" d:DesignHeight="846">

    <!-- Design-time-only: geeft Visual Studio/Blend's Designer een
         thema-context (kleuren, lettertype) - deze class library heeft
         zelf geen App.xaml die dat normaal doet. mc:Ignorable="d" zorgt
         dat dit bij het echt compileren/draaien volledig wegvalt. -->
    <d:UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Stylebook.Components;component/Styles/Theme.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Stylebook.Components;component/Styles/Themes/Lcars.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </d:UserControl.Resources>

    <!--
        Menu-regio component: het navigatiemenu van LocalAiStudio, om te
        stylen. Home, Projectselectie, Dependency, Zoeken, Projectassistent
        en Instellingen.

        Dit is het KIJKEXEMPLAAR: letterlijke teksten, geen klikafhandeling
        en geen versienummer uit de assembly. De werkende uitvoering staat in
        LocalAiStudio.App/Controls/Navigatiemenu - wat je hier verandert,
        vertel je door zodat het daar overgenomen wordt.

        Hoogte mag meebewegen, breedte niet: de knoppen staan in de *-rij en
        de zwarte strook met de versiebalk in de Auto-rij eronder, dus die
        blijven onderaan plakken hoe hoog het menu ook wordt. De breedte ligt
        vast in de Menu-kolom van Basis (256).
    -->
    <Border Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.RowSpan="2"
                    Background="{DynamicResource TextMutedBrush}"
                    theming:CornerRadiusParts.TopLeft="{DynamicResource RadiusElbow}"
                    theming:CornerRadiusParts.BottomLeft="{DynamicResource RadiusElbow}"/>

            <StackPanel Grid.Row="0"
                        theming:MarginParts.Left="{DynamicResource SpaceMedium}"
                        theming:MarginParts.Top="{DynamicResource SpaceLarge}"
                        theming:MarginParts.Right="{DynamicResource SpaceMedium}"
                        theming:MarginParts.Bottom="{DynamicResource SpaceLarge}">

                <!-- Home: terug naar Jabasoft. Geen scherm van deze app maar een andere applicatie, dus deze knop blijft nooit gemarkeerd staan. -->
                <Button x:Name="HomeButton" Content="Home" Foreground="{DynamicResource AccentForegroundBrush}" Background="{DynamicResource AccentBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="0" FontSize="{DynamicResource FontSizeTitle}" FontWeight="SemiBold" HorizontalContentAlignment="Left"
                        theming:MarginParts.Bottom="{DynamicResource SpaceSmall}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    theming:CornerRadiusParts.TopLeft="{DynamicResource RadiusXLarge}"
                                    theming:CornerRadiusParts.TopRight="{DynamicResource RadiusXLarge}"
                                    theming:CornerRadiusParts.BottomRight="{DynamicResource RadiusXLarge}"
                                    theming:PaddingParts.Left="{DynamicResource SpaceMedium}"
                                    theming:PaddingParts.Top="{DynamicResource SpaceSmall}"
                                    theming:PaddingParts.Right="{DynamicResource SpaceMedium}"
                                    theming:PaddingParts.Bottom="{DynamicResource SpaceSmall}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M12 3l9 8h-3v9h-5v-6h-2v6H6v-9H3z" Fill="{DynamicResource Text01Brush}" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center"
                                          theming:MarginParts.Right="{DynamicResource SpaceSmall}" />
                                    <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrushDark}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrushDark}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Projectselectie: kiezen waar je aan werkt. -->
                <Button x:Name="ProjectselectieButton" Content="Projectselectie" Foreground="{DynamicResource AccentForegroundBrush}" Background="{DynamicResource AccentBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="0" FontSize="{DynamicResource FontSizeTitle}" FontWeight="SemiBold" HorizontalContentAlignment="Left"
                        theming:MarginParts.Bottom="{DynamicResource SpaceSmall}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    theming:CornerRadiusParts.TopLeft="{DynamicResource RadiusXLarge}"
                                    theming:CornerRadiusParts.TopRight="{DynamicResource RadiusXLarge}"
                                    theming:CornerRadiusParts.BottomRight="{DynamicResource RadiusXLarge}"
                                    theming:PaddingParts.Left="{DynamicResource SpaceMedium}"
                                    theming:PaddingParts.Top="{DynamicResource SpaceSmall}"
                                    theming:PaddingParts.Right="{DynamicResource SpaceMedium}"
                                    theming:PaddingParts.Bottom="{DynamicResource SpaceSmall}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M10,4H4C2.9,4,2,4.9,2,6v12c0,1.1,0.9,2,2,2h16c1.1,0,2-0.9,2-2V8c0-1.1-0.9-2-2-2h-8L10,4z" Fill="{DynamicResource Text01Brush}" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center"
                                          theming:MarginParts.Right="{DynamicResource SpaceSmall}" />
                                    <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrushDark}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrushDark}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Dependency: hoe de onderdelen van elkaar afhangen. -->
                <Button x:Name="DependencyButton" Content="Dependency" Foreground="{DynamicResource AccentForegroundBrush}" Background="{DynamicResource AccentBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="0" FontSize="{DynamicResource FontSizeTitle}" FontWeight="SemiBold" HorizontalContentAlignment="Left"
                        theming:MarginParts.Bottom="{DynamicResource SpaceSmall}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    theming:CornerRadiusParts.TopLeft="{DynamicResource RadiusXLarge}"
                                    theming:CornerRadiusParts.TopRight="{DynamicResource RadiusXLarge}"
                                    theming:CornerRadiusParts.BottomRight="{DynamicResource RadiusXLarge}"
                                    theming:PaddingParts.Left="{DynamicResource SpaceMedium}"
                                    theming:PaddingParts.Top="{DynamicResource SpaceSmall}"
                                    theming:PaddingParts.Right="{DynamicResource SpaceMedium}"
                                    theming:PaddingParts.Bottom="{DynamicResource SpaceSmall}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M18,16.08c-0.76,0-1.44,0.3-1.96,0.77L8.91,12.7C8.96,12.47,9,12.24,9,12s-0.04-0.47-0.09-0.7l7.05-4.11C16.5,7.69,17.21,8,18,8c1.66,0,3-1.34,3-3s-1.34-3-3-3s-3,1.34-3,3c0,0.24,0.04,0.47,0.09,0.7L8.04,9.81C7.5,9.31,6.79,9,6,9c-1.66,0-3,1.34-3,3s1.34,3,3,3c0.79,0,1.5-0.31,2.04-0.81l7.12,4.16c-0.05,0.21-0.08,0.43-0.08,0.65c0,1.61,1.31,2.92,2.92,2.92s2.92-1.31,2.92-2.92S19.61,16.08,18,16.08z" Fill="{DynamicResource Text01Brush}" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center"
                                          theming:MarginParts.Right="{DynamicResource SpaceSmall}" />
                                    <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrushDark}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrushDark}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Zoeken: door de code van het gekozen project. -->
                <Button x:Name="ZoekenButton" Content="Zoeken" Foreground="{DynamicResource AccentForegroundBrush}" Background="{DynamicResource AccentBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="0" FontSize="{DynamicResource FontSizeTitle}" FontWeight="SemiBold" HorizontalContentAlignment="Left"
                        theming:MarginParts.Bottom="{DynamicResource SpaceSmall}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    theming:CornerRadiusParts.TopLeft="{DynamicResource RadiusXLarge}"
                                    theming:CornerRadiusParts.TopRight="{DynamicResource RadiusXLarge}"
                                    theming:CornerRadiusParts.BottomRight="{DynamicResource RadiusXLarge}"
                                    theming:PaddingParts.Left="{DynamicResource SpaceMedium}"
                                    theming:PaddingParts.Top="{DynamicResource SpaceSmall}"
                                    theming:PaddingParts.Right="{DynamicResource SpaceMedium}"
                                    theming:PaddingParts.Bottom="{DynamicResource SpaceSmall}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M15.5,14h-0.79l-0.28-0.27C15.41,12.59,16,11.11,16,9.5C16,5.91,13.09,3,9.5,3S3,5.91,3,9.5S5.91,16,9.5,16c1.61,0,3.09-0.59,4.23-1.57l0.27,0.28v0.79l5,4.99L20.49,19L15.5,14z M9.5,14C7.01,14,5,11.99,5,9.5S7.01,5,9.5,5S14,7.01,14,9.5S11.99,14,9.5,14z" Fill="{DynamicResource Text01Brush}" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center"
                                          theming:MarginParts.Right="{DynamicResource SpaceSmall}" />
                                    <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrushDark}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrushDark}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Projectassistent: het gesprek met de AI over dit project. -->
                <Button x:Name="ProjectassistentButton" Content="Projectassistent" Foreground="{DynamicResource AccentForegroundBrush}" Background="{DynamicResource AccentBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="0" FontSize="{DynamicResource FontSizeTitle}" FontWeight="SemiBold" HorizontalContentAlignment="Left"
                        theming:MarginParts.Bottom="{DynamicResource SpaceSmall}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    theming:CornerRadiusParts.TopLeft="{DynamicResource RadiusXLarge}"
                                    theming:CornerRadiusParts.TopRight="{DynamicResource RadiusXLarge}"
                                    theming:CornerRadiusParts.BottomRight="{DynamicResource RadiusXLarge}"
                                    theming:PaddingParts.Left="{DynamicResource SpaceMedium}"
                                    theming:PaddingParts.Top="{DynamicResource SpaceSmall}"
                                    theming:PaddingParts.Right="{DynamicResource SpaceMedium}"
                                    theming:PaddingParts.Bottom="{DynamicResource SpaceSmall}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M20,2H4C2.9,2,2,2.9,2,4v18l4-4h14c1.1,0,2-0.9,2-2V4C22,2.9,21.1,2,20,2z" Fill="{DynamicResource Text01Brush}" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center"
                                          theming:MarginParts.Right="{DynamicResource SpaceSmall}" />
                                    <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrushDark}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrushDark}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Settings: de instellingen van deze applicatie. -->
                <Button x:Name="SettingsButton" Content="Instellingen" Foreground="{DynamicResource AccentForegroundBrush}" Background="{DynamicResource AccentBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="0" FontSize="{DynamicResource FontSizeTitle}" FontWeight="SemiBold" HorizontalContentAlignment="Left"
                        theming:MarginParts.Bottom="{DynamicResource SpaceSmall}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    theming:CornerRadiusParts.TopLeft="{DynamicResource RadiusXLarge}"
                                    theming:CornerRadiusParts.TopRight="{DynamicResource RadiusXLarge}"
                                    theming:CornerRadiusParts.BottomRight="{DynamicResource RadiusXLarge}"
                                    theming:PaddingParts.Left="{DynamicResource SpaceMedium}"
                                    theming:PaddingParts.Top="{DynamicResource SpaceSmall}"
                                    theming:PaddingParts.Right="{DynamicResource SpaceMedium}"
                                    theming:PaddingParts.Bottom="{DynamicResource SpaceSmall}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M19.14,12.94c0.04-0.3,0.06-0.61,0.06-0.94c0-0.32-0.02-0.64-0.07-0.94l2.03-1.58c0.18-0.14,0.23-0.41,0.12-0.61l-1.92-3.32c-0.12-0.22-0.37-0.29-0.59-0.22l-2.39,0.96c-0.5-0.38-1.03-0.7-1.62-0.94L14.4,2.81c-0.04-0.24-0.24-0.41-0.48-0.41h-3.84c-0.24,0-0.43,0.17-0.47,0.41L9.25,5.35C8.66,5.59,8.12,5.92,7.63,6.29L5.24,5.33c-0.22-0.08-0.47,0-0.59,0.22L2.74,8.87C2.62,9.08,2.66,9.34,2.86,9.48l2.03,1.58C4.84,11.36,4.8,11.69,4.8,12s0.02,0.64,0.07,0.94l-2.03,1.58c-0.18,0.14-0.23,0.41-0.12,0.61l1.92,3.32c0.12,0.22,0.37,0.29,0.59,0.22l2.39-0.96c0.5,0.38,1.03,0.7,1.62,0.94l0.36,2.54c0.05,0.24,0.24,0.41,0.48,0.41h3.84c0.24,0,0.44-0.17,0.47-0.41l0.36-2.54c0.59-0.24,1.13-0.56,1.62-0.94l2.39,0.96c0.22,0.08,0.47,0,0.59-0.22l1.92-3.32c0.12-0.22,0.07-0.47-0.12-0.61L19.14,12.94z M12,15.6c-1.98,0-3.6-1.62-3.6-3.6s1.62-3.6,3.6-3.6s3.6,1.62,3.6,3.6S13.98,15.6,12,15.6z" Fill="{DynamicResource Text01Brush}" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center"
                                          theming:MarginParts.Right="{DynamicResource SpaceSmall}" />
                                    <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrushDark}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrushDark}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

            </StackPanel>

            <!-- Onderkant van het menu: blijft altijd onderaan staan, ook als
                 de hoogte van het menu verandert (Grid.Row="1", Auto-hoog,
                 na de *-rij met de knoppen hierboven - geen vaste pixel-
                 marges meer die alleen bij één specifieke hoogte kloppen). -->
            <StackPanel Grid.Row="1">
                <!-- Dun accentstrookje boven de versiebalk - bewust géén
                     LCARS-hoekafronding, daarvoor is 8px te dun.

                     Geen vaste Width meer (stond op 256): met de
                     SPACING-instelling krijgt het menublok een zwarte rand
                     en wordt het smaller dan 256, en dan stak deze balk er
                     aan de rechterkant uit. Uitrekken volgt de werkelijke
                     breedte van het blok. -->
                <Border Background="{DynamicResource BackgroundBrush}"
                        HorizontalAlignment="Stretch"
                        Height="{DynamicResource RegionGapSize}" />

                <!-- Versie-indicator. Het nummer staat hier NIET: de app zet
                     het bij het opbouwen van het menu, uitgelezen uit de
                     gebouwde assembly (zie Jabasoft.Base/AppVersion). Zo kan
                     wat hier staat niet afwijken van wat er werkelijk draait.
                     Ophogen doe je in het csproj van de applicatie. De
                     d:Text hieronder is alleen voor de ontwerpweergave. -->
                <Border x:Name="VersionBar"
                        theming:CornerRadiusParts.TopLeft="0"
                        theming:CornerRadiusParts.TopRight="0"
                        theming:CornerRadiusParts.BottomRight="0"
                        theming:CornerRadiusParts.BottomLeft="{DynamicResource RadiusElbow}"
                        Background="{DynamicResource AccentBrush}"
                        HorizontalAlignment="Stretch"
                        Height="40">
                    <TextBlock x:Name="VersionText"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Stretch"
                               Height="20"
                               Margin="30,0,16,0"
                               VerticalAlignment="Center"
                               TextAlignment="Right"
                               Text="V 0.1.0.1" />
                </Border>
            </StackPanel>
        </Grid>
    </Border>

</UserControl>







