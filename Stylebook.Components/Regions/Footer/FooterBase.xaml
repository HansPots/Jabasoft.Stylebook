<UserControl x:Class="Stylebook.Components.Regions.Footer.FooterBase"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="1920" d:DesignHeight="65">

    <!--
        Startpunt voor een nieuwe Footer-regio component: al op de echte
        afmeting die Basis.xaml voor Footer gebruikt (volle breedte x
        65px hoog). Kopieer dit bestand, hernoem de klasse (x:Class
        hierboven en FooterBase.xaml.cs), en vul de Grid hieronder met
        je eigen inhoud.
    -->
    <Grid Width="1920" Height="65" Background="{DynamicResource SurfaceBrush}">

    </Grid>

</UserControl>
