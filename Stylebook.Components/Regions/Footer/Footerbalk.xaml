<UserControl x:Class="Stylebook.Components.Regions.Footer.Footerbalk"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:theming="clr-namespace:Stylebook.Components.Theming"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">

    <!-- Footer-regio component: LCARS-balk met een verticale strook links
         die overloopt in een bocht en een horizontale balk. Kleuren via
         DynamicResource, dus volgt het actieve thema. -->
    <Border Background="{DynamicResource SurfaceBrush}"
            VerticalAlignment="Stretch">
        <Grid>
            <!-- Verticale balk: loopt automatisch tot onderkant kader -->
            <Border Background="{DynamicResource TextMutedBrush}"
                    Width="18"
                    Margin="0,48,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Stretch" />

            <!-- Bocht: diameter 96 px / radius 48 px -->
            <Path Fill="{DynamicResource TextMutedBrush}"
                  Width="48"
                  Height="48"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Top"
                  Stretch="None"
                  Data="
                      M 48,0
                      L 48,18
                      A 30,30 0 0 0 18,48
                      L 0,48
                      A 48,48 0 0 1 48,0
                      Z" />

            <!-- Horizontale balk: 18 px dik -->
            <Border Background="{DynamicResource TextMutedBrush}"
                    Height="18"
                    theming:MarginParts.Left="48"
                    theming:MarginParts.Bottom="{DynamicResource SpaceMedium}"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top" />
        </Grid>
    </Border>

</UserControl>
