<UserControl x:Class="Stylebook.Components.Regions.Algemeen.HeaderGradientBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:theming="clr-namespace:Stylebook.Components.Theming"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">

    <!-- Design-time-only: geeft Visual Studio/Blend's Designer een
         thema-context (kleuren, lettertype) - deze class library heeft
         zelf geen App.xaml die dat normaal doet. mc:Ignorable="d" zorgt
         dat dit bij het echt compileren/draaien volledig wegvalt. -->
    <d:UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Stylebook.Components;component/Styles/Theme.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Stylebook.Components;component/Styles/Themes/Lcars.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </d:UserControl.Resources>

    <!-- Algemeen: de LCARS-gradiëntbalk (ook los van HpoHeader bruikbaar).
         Links loopt de balk door in een elleboog naar beneden (48px breed,
         buitenbocht linksonder = 48) in de startkleur van de gradiënt - de
         gradiënt zelf begint pas ná die bocht, bij de balk. -->
    <Grid Width="Auto" Height="Auto" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Viewbox>
            <Canvas Width="648" Height="200">
                <Border theming:CornerRadiusParts.TopLeft="0"
                        theming:CornerRadiusParts.TopRight="0"
                        theming:CornerRadiusParts.BottomRight="0"
                        theming:CornerRadiusParts.BottomLeft="48"
                        Background="{DynamicResource HeaderGradientStartBrush}"
                        Canvas.Left="0" Canvas.Top="0"
                        Width="48" Height="200" />

                <Border theming:CornerRadiusParts.TopLeft="0"
                        theming:CornerRadiusParts.TopRight="4"
                        theming:CornerRadiusParts.BottomRight="4"
                        theming:CornerRadiusParts.BottomLeft="0"
                        Canvas.Left="48" Canvas.Top="0"
                        Width="600" Height="48">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                            <LinearGradientBrush.GradientStops>
                                <GradientStop Color="{DynamicResource HeaderGradientStartColor}" Offset="0" />
                                <GradientStop Color="{DynamicResource HeaderGradientMidColor}" Offset="0.45" />
                                <GradientStop Color="{DynamicResource HeaderGradientEndColor}" Offset="1" />
                            </LinearGradientBrush.GradientStops>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
            </Canvas>
        </Viewbox>
    </Grid>

</UserControl>
