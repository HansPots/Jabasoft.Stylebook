<UserControl x:Class="Stylebook.Components.Regions.Algemeen.LcarsElbowAccent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:theming="clr-namespace:Stylebook.Components.Theming"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">

    <!-- Algemeen: LCARS-hoekblok (alleen linksonder rond), AccentForegroundBrush-kleur, 48x200. -->
    <Border theming:CornerRadiusParts.TopLeft="0"
            theming:CornerRadiusParts.TopRight="0"
            theming:CornerRadiusParts.BottomRight="0"
            theming:CornerRadiusParts.BottomLeft="48"
            Background="{DynamicResource AccentForegroundBrush}"
            Width="48"
            Height="200" />

</UserControl>
